{
  "name": "nemo-cleaning-backapp",
  "version": "1.0.0",
  "private": true,
  "description": "API de Nemo Cleaning Services: pedidos, agenda por sucursal, pagos (Payphone, efectivo, transferencia), gastos y reportes. Express 5 + Mongoose + TypeScript.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "compile": "tsc --watch",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "format": "prettier --write 'src/**/*.{ts,json,md}' 'api/**/*.ts'",
    "seed:catalog-real": "ts-node-dev --transpile-only src/scripts/seedCatalogReal.ts",
    "migrate:2026-10": "ts-node-dev --transpile-only src/scripts/migratePrices202610.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "prettier": "^3.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
