# --- Servidor ---
DB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/nemo-cleaning?retryWrites=true&w=majority
PORT=8100
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Opcional: avisa a Slack los errores 5xx
SLACK_ERROR_WEBHOOK=
# Orígenes extra permitidos por CORS, separados por coma (FRONTEND_URL y localhost:5173 ya se permiten)
CORS_ORIGINS=https://nemocleaning.ec,https://www.nemocleaning.ec
FRONTEND_URL=https://nemocleaning.ec
API_PUBLIC_URL=https://api.nemocleaning.ec

# --- Cuenta de administración (se crea al arrancar si no existe; entra con código al correo) ---
ADMIN_EMAIL=admin@nemocleaning.ec
ADMIN_NAME=Gerencia Nemo

# --- Correo (Resend). Sin key no se envía nada y la app sigue funcionando ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nemo Cleaning <reservas@nemocleaning.ec>
# Correo de administración por defecto (si Settings.notifyEmails está vacío)
NOTIFY_EMAIL=

# Reservado para un cron futuro
CRON_SECRET=

# --- Cloudinary (comprobantes e imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payphone (Cajita de Pagos). Sin ambos, el pago con tarjeta queda desactivado ---
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
